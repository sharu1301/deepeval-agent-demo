# Copy to .env and fill in. NEVER commit .env
# Provider for BOTH the app and the judge: ollama | groq | gemini  (all FREE)
LLM_PROVIDER=ollama

# Optional: different providers for app and judge (e.g. local app, stronger cloud judge)
# APP_PROVIDER=ollama
# JUDGE_PROVIDER=groq

# Free API keys (only for the provider you use)
GROQ_API_KEY=
GEMINI_API_KEY=

# Model overrides if you see "model not found"
# OLLAMA_MODEL=qwen2.5:7b
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-flash-latest

CALL_DELAY=0        # raise to 3 if you hit free-tier 429s
BREAK_RETRIEVER=0   # 1 = simulate a retrieval bug (root-cause demo)
